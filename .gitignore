# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
data/
public/strokes-data

# T-064: local Argos Translate venv (scripts/mt/setup-argos.sh) — a build-time
# tool for the maintainer, not a runtime/repo dependency. Multi-hundred-MB.
.argos-venv/
# T-064: --stub dry runs of scripts/mt-grammar-seed.ts — fake content, never
# loaded by the app, never committed.
public/grammar-seed/*.stub.json

# claude code local state (settings + worktrees); .claude/skills/ IS tracked
.claude/*
!.claude/skills/
.wrangler/
.static-build-aside/

# T-059: npm pack output, never committed (tarball is regenerated on demand)
packages/*/*.tgz
