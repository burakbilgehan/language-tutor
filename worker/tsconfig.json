{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // @cloudflare/workers-types for the runtime; vitest-pool-workers/types for
    // the `cloudflare:test` module used by test/.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // test/ and the schema-gen config were previously outside `include`, so
  // `npm run typecheck` silently skipped them. Widened so a type error there
  // is a real failure.
  "include": ["src/**/*.ts", "test/**/*.ts", "schema-gen.config.ts", "vitest.config.ts"]
}
